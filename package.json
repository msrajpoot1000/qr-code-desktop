{
  "name": "quick-scanner",
  "version": "1.5.0",
  "description": "Quick Scanner for desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Manish Singh",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.calculator.app",
    "productName": "Quick Scanner",
    "directories": {
      "output": "release-builds"
    },
   "files": [
  "main.js",
  "index.html",
  "assets/**/*",
  "node_modules/**/*"
],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/image/logo/app_logo.ico",
       "publisherName": "Manish Singh"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Scanner"
    }
  }
}
